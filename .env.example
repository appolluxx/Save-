# =============================================================================
# SaveRaks Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT (DO NOT COMMIT REAL SECRETS)
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection URL (Prisma)
# Example local: postgresql://postgres:postgres@localhost:5432/saveraks?schema=public
# Example Render: postgresql://saveraks_user:password@dpg-xxxxx.render.com/saveraks?sslmode=require
DATABASE_URL=postgresql://saveraks_user:change_me_in_local_env@localhost:5432/saveraks?schema=public

# Authentication Secrets (Must be at least 32 characters for JWT, 16 for invite)
JWT_SECRET=replace_with_at_least_32_characters_random_string_here
STAFF_INVITE_SECRET=replace_with_staff_invite_code_secret

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://saveraks.onrender.com

# Cloud Object Storage (Persistent storage for photos and thumbnails)
# Options: cloudinary | s3 | minio
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Computer Vision Services (Server-Side Only)
GROQ_API_KEY=your_groq_vision_api_key_here
GEMINI_API_KEY=your_gemini_flash_api_key_here

# Google OAuth 2.0 Web Client ID (Public client ID used for token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Public Variables (Used during apps/web build)
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
