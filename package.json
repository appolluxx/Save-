{
  "name": "saveraks",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SaveRaks - Environmental Engagement Platform for Surasakmontree School",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:shared": "pnpm --filter @saveraks/shared test",
    "test:api": "pnpm --filter @saveraks/api test",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @saveraks/shared build",
    "build:api": "pnpm --filter @saveraks/api build"
  },
  "devDependencies": {
    "@saveraks/shared": "workspace:*"
  }
}
